{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RotmanSells/vse-pro-zhar-mobile/contracts/tasks/task.schema.json",
  "title": "Vse Pro Zhar task manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "title",
    "goal",
    "scope",
    "acceptance_criteria",
    "test_plan",
    "verification",
    "api_change",
    "database_change",
    "architecture_change",
    "security_sensitive",
    "docs_impact",
    "e2e_required",
    "regression_test_required",
    "adr",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^VPZH-[0-9]{3,}$"
    },
    "type": {
      "type": "string",
      "enum": ["feature", "bugfix", "architecture", "chore", "docs"]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "base_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "scenario": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modules", "layers", "paths", "in", "out"],
      "properties": {
        "modules": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "layers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "in": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "out": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "test_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "integration", "e2e"],
      "properties": {
        "unit": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "integration": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "e2e": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commands", "manual"],
      "properties": {
        "commands": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "manual": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "api_change": { "type": "boolean" },
    "database_change": { "type": "boolean" },
    "architecture_change": { "type": "boolean" },
    "security_sensitive": { "type": "boolean" },
    "docs_impact": { "type": "boolean" },
    "e2e_required": { "type": "boolean" },
    "regression_test_required": { "type": "boolean" },
    "adr": {
      "type": ["string", "null"],
      "pattern": "^(ADR-[0-9]{3,})$"
    },
    "status": {
      "type": "string",
      "enum": ["planned", "in_progress", "completed"],
      "default": "planned"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": { "enum": ["feature", "bugfix"] }
        }
      },
      "then": {
        "required": ["scenario"]
      }
    },
    {
      "if": {
        "properties": {
          "status": { "enum": ["planned", "in_progress"] }
        }
      },
      "then": {
        "required": ["base_commit"]
      }
    }
  ]
}
