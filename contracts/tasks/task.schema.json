{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RotmanSells/vse-pro-zhar-mobile/contracts/tasks/task.schema.json",
  "title": "Vse Pro Zhar task manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "scope", "acceptance_criteria"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^VPZH-[0-9]{3,}$"
    },
    "type": {
      "type": "string",
      "enum": ["feature", "bugfix", "architecture", "chore", "docs"]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modules", "paths"],
      "properties": {
        "modules": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "paths": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "api_change": { "type": "boolean", "default": false },
    "database_change": { "type": "boolean", "default": false },
    "architecture_change": { "type": "boolean", "default": false },
    "security_sensitive": { "type": "boolean", "default": false },
    "docs_impact": { "type": "boolean", "default": false },
    "e2e_required": { "type": "boolean", "default": false },
    "regression_test_required": { "type": "boolean", "default": false },
    "adr": {
      "type": ["string", "null"],
      "pattern": "^(ADR-[0-9]{3,})$"
    },
    "status": {
      "type": "string",
      "enum": ["planned", "in_progress", "completed"],
      "default": "planned"
    }
  }
}
