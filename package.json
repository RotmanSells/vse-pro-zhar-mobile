{
  "name": "vse-pro-zhar-mobile",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "24.14.1",
    "pnpm": "11.7.0"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test:unit": "jest --config jest.config.cjs --runInBand",
    "check:test-hygiene": "node scripts/checks/test-hygiene.mjs",
    "test:architecture": "node scripts/checks/architecture.mjs",
    "check:automation-sync": "node scripts/checks/automation-sync.mjs",
    "check:checker-exit-codes": "node scripts/checks/checker-exit-codes.mjs",
    "check:task-contract": "node scripts/checks/task-contract.mjs",
    "check:task-scope": "node scripts/checks/task-scope.mjs",
    "check:diff-size": "node scripts/checks/diff-size.mjs",
    "build": "tsc --project tsconfig.build.json",
    "verify:fast": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:unit",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm check:test-hygiene && pnpm test:unit && pnpm test:architecture && pnpm check:automation-sync && pnpm check:checker-exit-codes && pnpm build"
  },
  "devDependencies": {
    "@babel/parser": "8.0.4",
    "@eslint/js": "10.0.1",
    "@types/jest": "30.0.0",
    "@types/node": "24.13.3",
    "ajv": "8.20.0",
    "dependency-cruiser": "18.2.0",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "jest": "30.4.2",
    "prettier": "3.9.6",
    "ts-jest": "29.4.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "yaml": "2.9.0"
  }
}
