{
  "openapi": "3.1.0",
  "info": {
    "title": "Vse Pro Zhar API",
    "version": "0.1.0",
    "description": "The liveness health contract, persisted customer profile contract, test-only legal acceptance contract and Category/Product catalog contracts."
  },
  "servers": [{ "url": "http://127.0.0.1:3000", "description": "Local API shell" }],
  "paths": {
    "/admin/categories": {
      "parameters": [{ "$ref": "#/components/parameters/DevelopmentAdminIdentity" }],
      "post": {
        "operationId": "createCategory",
        "summary": "Create a Category through the development/test Admin boundary",
        "description": "This Admin identity boundary is development/test only and is always disabled in production; it is not production authentication.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateCategoryRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The persisted Category.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/CategoryResponse" } }
            }
          },
          "400": {
            "description": "The request body is invalid.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorResponse" } }
            }
          },
          "401": {
            "description": "The development/test Admin identity was not accepted.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorResponse" } }
            }
          },
          "403": {
            "description": "The authenticated principal lacks the named Category-create permission.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorResponse" } }
            }
          },
          "405": {
            "description": "Unsupported method.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorResponse" } }
            }
          },
          "500": {
            "description": "An unexpected persistence or handler error.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorResponse" } }
            }
          }
        }
      }
    },
    "/categories": {
      "get": {
        "operationId": "listCategories",
        "summary": "List persisted Categories for unauthenticated Guests",
        "responses": {
          "200": {
            "description": "The persisted Category list.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CategoryListResponse" }
              }
            }
          },
          "405": {
            "description": "Unsupported method.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorResponse" } }
            }
          },
          "500": {
            "description": "An unexpected persistence or handler error.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorResponse" } }
            }
          }
        }
      }
    },
    "/admin/products": {
      "parameters": [{ "$ref": "#/components/parameters/DevelopmentAdminIdentity" }],
      "post": {
        "operationId": "createProduct",
        "summary": "Create a Product through the development/test Admin boundary",
        "description": "Creates a Product attached to one existing Category. The Admin identity boundary is development/test only and is not production authentication.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateProductRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The persisted Product.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ProductResponse" } }
            }
          },
          "400": {
            "description": "The request body is invalid.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorResponse" } }
            }
          },
          "401": {
            "description": "The development/test Admin identity was not accepted.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorResponse" } }
            }
          },
          "403": {
            "description": "The authenticated principal lacks the named Product-create permission.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorResponse" } }
            }
          },
          "404": {
            "description": "The requested Category does not exist.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorResponse" } }
            }
          },
          "405": {
            "description": "Unsupported method.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorResponse" } }
            }
          },
          "500": {
            "description": "An unexpected persistence or handler error.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorResponse" } }
            }
          }
        }
      }
    },
    "/products": {
      "get": {
        "operationId": "listProducts",
        "summary": "List persisted visible Products for unauthenticated Guests",
        "responses": {
          "200": {
            "description": "The persisted admin-enabled Product list.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ProductListResponse" }
              }
            }
          },
          "405": {
            "description": "Unsupported method.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorResponse" } }
            }
          },
          "500": {
            "description": "An unexpected persistence or handler error.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorResponse" } }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Return API liveness",
        "responses": {
          "200": {
            "description": "The API process is available.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/HealthResponse" } }
            }
          },
          "405": {
            "description": "Unsupported method.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorResponse" } }
            }
          },
          "500": {
            "description": "Safe internal error.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorResponse" } }
            }
          }
        }
      }
    },
    "/me/profile": {
      "parameters": [{ "$ref": "#/components/parameters/DevelopmentIdentity" }],
      "get": {
        "operationId": "getCurrentCustomerProfile",
        "summary": "Get the current development/test customer profile",
        "responses": {
          "200": {
            "description": "The persisted customer profile.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CustomerProfileResponse" }
              }
            }
          },
          "401": {
            "description": "No non-production identity boundary was accepted.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorResponse" } }
            }
          },
          "500": {
            "description": "An unexpected persistence or handler error.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorResponse" } }
            }
          }
        }
      },
      "patch": {
        "operationId": "updateCurrentCustomerProfile",
        "summary": "Update the allowed current customer profile fields",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CustomerProfilePatchRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The updated persisted customer profile.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CustomerProfileResponse" }
              }
            }
          },
          "400": {
            "description": "The request body is invalid.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorResponse" } }
            }
          },
          "401": {
            "description": "No non-production identity boundary was accepted.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorResponse" } }
            }
          },
          "405": {
            "description": "Unsupported method.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorResponse" } }
            }
          },
          "500": {
            "description": "An unexpected persistence or handler error.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorResponse" } }
            }
          }
        }
      }
    },
    "/me/legal-acceptances": {
      "parameters": [{ "$ref": "#/components/parameters/DevelopmentIdentity" }],
      "get": {
        "operationId": "getCurrentLegalAcceptances",
        "summary": "Get required test-only legal acceptance state for the current customer",
        "responses": {
          "200": {
            "description": "Required documents and persisted test-only acceptances.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LegalAcceptanceResponse" }
              }
            }
          },
          "401": {
            "description": "No non-production identity boundary was accepted.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorResponse" } }
            }
          },
          "500": {
            "description": "An unexpected persistence or handler error.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorResponse" } }
            }
          }
        }
      },
      "post": {
        "operationId": "recordCurrentLegalAcceptance",
        "summary": "Record an explicit acceptance of one required test-only document",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RecordLegalAcceptanceRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The persisted test-only legal acceptance state.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LegalAcceptanceResponse" }
              }
            }
          },
          "400": {
            "description": "The request body is invalid.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorResponse" } }
            }
          },
          "401": {
            "description": "No non-production identity boundary was accepted.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorResponse" } }
            }
          },
          "405": {
            "description": "Unsupported method.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorResponse" } }
            }
          },
          "500": {
            "description": "An unexpected persistence or handler error.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorResponse" } }
            }
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "DevelopmentAdminIdentity": {
        "name": "X-VPZH-Development-Admin-Identity",
        "in": "header",
        "required": true,
        "description": "Synthetic Admin identity for development/test only. The exact value is admin; this boundary is production-disabled and is not production authentication.",
        "schema": { "type": "string", "const": "admin" }
      },
      "DevelopmentIdentity": {
        "name": "X-VPZH-Development-Identity",
        "in": "header",
        "required": true,
        "description": "Explicit opt-in development/test phone input. This boundary is disabled in production and is not production authentication.",
        "schema": { "type": "string", "minLength": 1, "maxLength": 255 }
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "service", "version", "timestamp"],
        "properties": {
          "status": { "type": "string", "const": "ok" },
          "service": { "type": "string", "const": "vse-pro-zhar-api" },
          "version": { "type": "string", "minLength": 1 },
          "timestamp": { "type": "string", "format": "date-time" }
        }
      },
      "ApiErrorResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "message"],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "AUTHENTICATION_REQUIRED",
                  "FORBIDDEN",
                  "INTERNAL_SERVER_ERROR",
                  "INVALID_REQUEST",
                  "METHOD_NOT_ALLOWED",
                  "NOT_FOUND"
                ]
              },
              "message": { "type": "string", "minLength": 1 }
            }
          }
        }
      },
      "CategoryResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string", "minLength": 1, "maxLength": 200 }
        }
      },
      "CategoryListResponse": {
        "type": "array",
        "items": { "$ref": "#/components/schemas/CategoryResponse" }
      },
      "CreateCategoryRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 200 }
        }
      },
      "ProductResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "categoryId", "name", "basePriceMinor", "adminEnabled"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "categoryId": { "type": "string", "format": "uuid" },
          "name": { "type": "string", "minLength": 1, "maxLength": 200 },
          "basePriceMinor": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
          "adminEnabled": { "type": "boolean" }
        }
      },
      "ProductListResponse": {
        "type": "array",
        "items": { "$ref": "#/components/schemas/ProductResponse" }
      },
      "CreateProductRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["categoryId", "name", "basePriceMinor", "adminEnabled"],
        "properties": {
          "categoryId": { "type": "string", "format": "uuid" },
          "name": { "type": "string", "minLength": 1, "maxLength": 200 },
          "basePriceMinor": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
          "adminEnabled": { "type": "boolean" }
        }
      },
      "CustomerProfileResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["customerId", "phone", "name", "birthday", "createdAt", "updatedAt"],
        "properties": {
          "customerId": { "type": "string", "format": "uuid" },
          "phone": { "type": "string", "minLength": 1, "maxLength": 255 },
          "name": { "type": ["string", "null"], "minLength": 1, "maxLength": 200 },
          "birthday": { "type": ["string", "null"], "format": "date" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "CustomerProfilePatchRequest": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "name": { "type": ["string", "null"], "minLength": 1, "maxLength": 200 },
          "birthday": { "type": ["string", "null"], "format": "date" }
        }
      },
      "RecordLegalAcceptanceRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["documentType"],
        "properties": {
          "documentType": {
            "type": "string",
            "enum": ["privacy_policy", "user_agreement"]
          }
        }
      },
      "LegalAcceptanceDocument": {
        "type": "object",
        "additionalProperties": false,
        "required": ["acceptedAt", "documentType", "documentVersion", "status"],
        "properties": {
          "acceptedAt": { "type": ["string", "null"], "format": "date-time" },
          "documentType": { "type": "string", "enum": ["privacy_policy", "user_agreement"] },
          "documentVersion": {
            "type": "string",
            "enum": ["test-privacy-policy-v1", "test-user-agreement-v1"]
          },
          "status": { "type": "string", "enum": ["required", "accepted"] }
        }
      },
      "LegalAcceptanceResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["documents", "mode"],
        "properties": {
          "documents": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": { "$ref": "#/components/schemas/LegalAcceptanceDocument" }
          },
          "mode": { "type": "string", "const": "test_only" }
        }
      }
    }
  }
}
