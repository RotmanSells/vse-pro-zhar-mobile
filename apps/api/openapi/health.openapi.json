{
  "openapi": "3.1.0",
  "info": {
    "title": "Vse Pro Zhar API",
    "version": "0.1.0",
    "description": "The liveness health contract, persisted customer profile contract, test-only legal acceptance contract, Category/Product catalog contracts and the approved Product imagery boundary."
  },
  "servers": [{ "url": "http://127.0.0.1:3000", "description": "Local API shell" }],
  "paths": {
    "/admin/categories": {
      "parameters": [{ "$ref": "#/components/parameters/DevelopmentAdminIdentity" }],
      "post": {
        "operationId": "createCategory",
        "summary": "Create a Category through the development/test Admin boundary",
        "description": "This Admin identity boundary is development/test only and is always disabled in production; it is not production authentication.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateCategoryRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The persisted Category.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/CategoryResponse" } }
            }
          },
          "400": {
            "description": "The request body is invalid.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorResponse" } }
            }
          },
          "401": {
            "description": "The development/test Admin identity was not accepted.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorResponse" } }
            }
          },
          "403": {
            "description": "The authenticated principal lacks the named Category-create permission.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorResponse" } }
            }
          },
          "405": {
            "description": "Unsupported method.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorResponse" } }
            }
          },
          "500": {
            "description": "An unexpected persistence or handler error.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorResponse" } }
            }
          }
        }
      }
    },
    "/categories": {
      "get": {
        "operationId": "listCategories",
        "summary": "List persisted Categories for unauthenticated Guests",
        "responses": {
          "200": {
            "description": "The persisted Category list.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CategoryListResponse" }
              }
            }
          },
          "405": {
            "description": "Unsupported method.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorResponse" } }
            }
          },
          "500": {
            "description": "An unexpected persistence or handler error.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorResponse" } }
            }
          }
        }
      }
    },
    "/admin/products": {
      "parameters": [{ "$ref": "#/components/parameters/DevelopmentAdminIdentity" }],
      "post": {
        "operationId": "createProduct",
        "summary": "Create a Product through the development/test Admin boundary",
        "description": "Creates a Product attached to one existing Category. The Admin identity boundary is development/test only and is not production authentication.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateProductRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The persisted Product.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ProductResponse" } }
            }
          },
          "400": {
            "description": "The request body is invalid.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorResponse" } }
            }
          },
          "401": {
            "description": "The development/test Admin identity was not accepted.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorResponse" } }
            }
          },
          "403": {
            "description": "The authenticated principal lacks the named Product-create permission.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorResponse" } }
            }
          },
          "404": {
            "description": "The requested Category does not exist.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorResponse" } }
            }
          },
          "410": {
            "description": "The legacy JSON Product write is disabled after the write freeze.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorResponse" } }
            }
          },
          "405": {
            "description": "Unsupported method.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorResponse" } }
            }
          },
          "500": {
            "description": "An unexpected persistence or handler error.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorResponse" } }
            }
          }
        }
      },
      "get": {
        "operationId": "listAdminProducts",
        "summary": "List all persisted Products through the development/test Admin boundary",
        "description": "Returns visible and hidden Products so Admin can restore a Product after hiding it. The Admin identity boundary is development/test only and is not production authentication.",
        "responses": {
          "200": {
            "description": "All persisted Products, including hidden Products.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ProductListResponse" }
              }
            }
          },
          "401": {
            "description": "The development/test Admin identity was not accepted.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorResponse" } }
            }
          },
          "405": {
            "description": "Unsupported method.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorResponse" } }
            }
          },
          "500": {
            "description": "An unexpected persistence or handler error.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorResponse" } }
            }
          }
        }
      }
    },
    "/products": {
      "get": {
        "operationId": "listProducts",
        "summary": "List persisted visible Products for unauthenticated Guests",
        "responses": {
          "200": {
            "description": "The persisted admin-enabled Product list.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ProductListResponse" }
              }
            }
          },
          "405": {
            "description": "Unsupported method.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorResponse" } }
            }
          },
          "500": {
            "description": "An unexpected persistence or handler error.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorResponse" } }
            }
          }
        }
      }
    },
    "/v2/admin/products": {
      "parameters": [{ "$ref": "#/components/parameters/DevelopmentAdminIdentity" }],
      "post": {
        "operationId": "createProductWithImage",
        "summary": "Create a Product with its required main image",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": { "$ref": "#/components/schemas/CreateProductWithImageRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The persisted image-aware Product.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ProductWithImageResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ApiError400" },
          "401": { "$ref": "#/components/responses/ApiError401" },
          "403": { "$ref": "#/components/responses/ApiError403" },
          "404": { "$ref": "#/components/responses/ApiError404" },
          "409": { "$ref": "#/components/responses/ApiError409" },
          "413": { "$ref": "#/components/responses/ApiError413" },
          "415": { "$ref": "#/components/responses/ApiError415" },
          "422": { "$ref": "#/components/responses/ApiError422" },
          "500": { "$ref": "#/components/responses/ApiError500" }
        }
      }
    },
    "/v2/admin/products/{productId}/image": {
      "parameters": [
        { "$ref": "#/components/parameters/DevelopmentAdminIdentity" },
        { "$ref": "#/components/parameters/ProductId" }
      ],
      "put": {
        "operationId": "replaceProductImage",
        "summary": "Replace the required Product main image",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": { "$ref": "#/components/schemas/ProductImageMultipartRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The updated image-aware Product.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ProductWithImageResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ApiError400" },
          "401": { "$ref": "#/components/responses/ApiError401" },
          "403": { "$ref": "#/components/responses/ApiError403" },
          "404": { "$ref": "#/components/responses/ApiError404" },
          "409": { "$ref": "#/components/responses/ApiError409" },
          "413": { "$ref": "#/components/responses/ApiError413" },
          "415": { "$ref": "#/components/responses/ApiError415" },
          "422": { "$ref": "#/components/responses/ApiError422" },
          "500": { "$ref": "#/components/responses/ApiError500" }
        }
      }
    },
    "/v2/products": {
      "get": {
        "operationId": "listProductsWithImages",
        "summary": "List visible Products with their Backend-controlled image URLs",
        "responses": {
          "200": {
            "description": "The persisted visible image-aware Product list.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ProductWithImageListResponse" }
              }
            }
          },
          "404": { "$ref": "#/components/responses/ApiError404" },
          "500": { "$ref": "#/components/responses/ApiError500" }
        }
      }
    },
    "/v2/products/{productId}": {
      "parameters": [{ "$ref": "#/components/parameters/ProductId" }],
      "get": {
        "operationId": "getProductWithImage",
        "summary": "Get one visible image-aware Product",
        "responses": {
          "200": {
            "description": "The persisted visible image-aware Product details.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ProductDetailsWithImageResponse" }
              }
            }
          },
          "404": { "$ref": "#/components/responses/ApiError404" },
          "500": { "$ref": "#/components/responses/ApiError500" }
        }
      }
    },
    "/products/{productId}/image/{imageRevision}": {
      "parameters": [
        { "$ref": "#/components/parameters/ProductId" },
        { "$ref": "#/components/parameters/ImageRevision" }
      ],
      "get": {
        "operationId": "getProductImage",
        "summary": "Serve the current image of a visible Product",
        "responses": {
          "200": {
            "description": "The processed WebP image.",
            "headers": {
              "ETag": { "schema": { "type": "string" } },
              "Cache-Control": { "schema": { "type": "string", "const": "private, no-cache" } }
            },
            "content": { "image/webp": { "schema": { "type": "string", "format": "binary" } } }
          },
          "304": { "description": "The current ETag matches." },
          "404": { "$ref": "#/components/responses/ApiError404" },
          "503": { "$ref": "#/components/responses/ApiError503" }
        }
      }
    },
    "/admin/products/{productId}/details": {
      "parameters": [
        { "$ref": "#/components/parameters/DevelopmentAdminIdentity" },
        { "$ref": "#/components/parameters/ProductId" }
      ],
      "patch": {
        "operationId": "updateProductDetails",
        "summary": "Update approved Product details through the development/test Admin boundary",
        "description": "Updates only description, weight and the new/hit flags. Name, Category, base price and Admin visibility are not changed by this operation.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateProductDetailsRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The updated persisted Product.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ProductResponse" } }
            }
          },
          "400": {
            "description": "The request body is invalid.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorResponse" } }
            }
          },
          "401": {
            "description": "The development/test Admin identity was not accepted.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorResponse" } }
            }
          },
          "403": {
            "description": "The Admin principal lacks the named Product-update permission.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorResponse" } }
            }
          },
          "404": {
            "description": "The requested Product does not exist.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorResponse" } }
            }
          },
          "405": {
            "description": "Unsupported method.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorResponse" } }
            }
          },
          "500": {
            "description": "An unexpected persistence or handler error.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorResponse" } }
            }
          }
        }
      }
    },
    "/products/{productId}": {
      "parameters": [{ "$ref": "#/components/parameters/ProductId" }],
      "get": {
        "operationId": "getProductDetails",
        "summary": "Get one visible Product with approved details for an unauthenticated Guest",
        "responses": {
          "200": {
            "description": "The persisted visible Product details.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ProductDetailsResponse" }
              }
            }
          },
          "404": {
            "description": "The Product is unknown or hidden from the catalog.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorResponse" } }
            }
          },
          "405": {
            "description": "Unsupported method.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorResponse" } }
            }
          },
          "500": {
            "description": "An unexpected persistence or handler error.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorResponse" } }
            }
          }
        }
      }
    },
    "/admin/products/{productId}/visibility": {
      "parameters": [
        { "$ref": "#/components/parameters/DevelopmentAdminIdentity" },
        { "$ref": "#/components/parameters/ProductId" }
      ],
      "patch": {
        "operationId": "updateProductVisibility",
        "summary": "Update Product catalog visibility through the development/test Admin boundary",
        "description": "Changes only the existing admin_enabled catalog visibility flag. The Product row is preserved and remains available in the Admin list.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateProductVisibilityRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The updated persisted Product.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ProductResponse" } }
            }
          },
          "400": { "$ref": "#/components/responses/ApiError400" },
          "401": { "$ref": "#/components/responses/ApiError401" },
          "403": { "$ref": "#/components/responses/ApiError403" },
          "404": { "$ref": "#/components/responses/ApiError404" },
          "405": { "$ref": "#/components/responses/ApiError405" },
          "500": { "$ref": "#/components/responses/ApiError500" }
        }
      }
    },
    "/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Return API liveness",
        "responses": {
          "200": {
            "description": "The API process is available.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/HealthResponse" } }
            }
          },
          "405": {
            "description": "Unsupported method.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorResponse" } }
            }
          },
          "500": {
            "description": "Safe internal error.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorResponse" } }
            }
          }
        }
      }
    },
    "/me/profile": {
      "parameters": [{ "$ref": "#/components/parameters/DevelopmentIdentity" }],
      "get": {
        "operationId": "getCurrentCustomerProfile",
        "summary": "Get the current development/test customer profile",
        "responses": {
          "200": {
            "description": "The persisted customer profile.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CustomerProfileResponse" }
              }
            }
          },
          "401": {
            "description": "No non-production identity boundary was accepted.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorResponse" } }
            }
          },
          "500": {
            "description": "An unexpected persistence or handler error.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorResponse" } }
            }
          }
        }
      },
      "patch": {
        "operationId": "updateCurrentCustomerProfile",
        "summary": "Update the allowed current customer profile fields",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CustomerProfilePatchRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The updated persisted customer profile.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CustomerProfileResponse" }
              }
            }
          },
          "400": {
            "description": "The request body is invalid.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorResponse" } }
            }
          },
          "401": {
            "description": "No non-production identity boundary was accepted.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorResponse" } }
            }
          },
          "405": {
            "description": "Unsupported method.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorResponse" } }
            }
          },
          "500": {
            "description": "An unexpected persistence or handler error.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorResponse" } }
            }
          }
        }
      }
    },
    "/me/legal-acceptances": {
      "parameters": [{ "$ref": "#/components/parameters/DevelopmentIdentity" }],
      "get": {
        "operationId": "getCurrentLegalAcceptances",
        "summary": "Get required test-only legal acceptance state for the current customer",
        "responses": {
          "200": {
            "description": "Required documents and persisted test-only acceptances.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LegalAcceptanceResponse" }
              }
            }
          },
          "401": {
            "description": "No non-production identity boundary was accepted.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorResponse" } }
            }
          },
          "500": {
            "description": "An unexpected persistence or handler error.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorResponse" } }
            }
          }
        }
      },
      "post": {
        "operationId": "recordCurrentLegalAcceptance",
        "summary": "Record an explicit acceptance of one required test-only document",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RecordLegalAcceptanceRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The persisted test-only legal acceptance state.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LegalAcceptanceResponse" }
              }
            }
          },
          "400": {
            "description": "The request body is invalid.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorResponse" } }
            }
          },
          "401": {
            "description": "No non-production identity boundary was accepted.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorResponse" } }
            }
          },
          "405": {
            "description": "Unsupported method.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorResponse" } }
            }
          },
          "500": {
            "description": "An unexpected persistence or handler error.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorResponse" } }
            }
          }
        }
      }
    }
  },
  "components": {
    "responses": {
      "ApiError400": {
        "description": "The request is invalid.",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorResponse" } }
        }
      },
      "ApiError401": {
        "description": "The Admin identity was not accepted.",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorResponse" } }
        }
      },
      "ApiError403": {
        "description": "The named image permission was not granted.",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorResponse" } }
        }
      },
      "ApiError404": {
        "description": "The Product or current image revision was not found.",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorResponse" } }
        }
      },
      "ApiError409": {
        "description": "The image mutation conflicted with another update.",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorResponse" } }
        }
      },
      "ApiError410": {
        "description": "The legacy Product write is disabled.",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorResponse" } }
        }
      },
      "ApiError413": {
        "description": "The multipart body or file is too large.",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorResponse" } }
        }
      },
      "ApiError415": {
        "description": "The multipart request media type is unsupported.",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorResponse" } }
        }
      },
      "ApiError422": {
        "description": "The image could not be validated or converted.",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorResponse" } }
        }
      },
      "ApiError500": {
        "description": "An unexpected persistence or handler error.",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorResponse" } }
        }
      },
      "ApiError503": {
        "description": "Object storage is unavailable.",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorResponse" } }
        }
      }
    },
    "parameters": {
      "DevelopmentAdminIdentity": {
        "name": "X-VPZH-Development-Admin-Identity",
        "in": "header",
        "required": true,
        "description": "Synthetic Admin identity for development/test only. The exact value is admin; this boundary is production-disabled and is not production authentication.",
        "schema": { "type": "string", "const": "admin" }
      },
      "DevelopmentIdentity": {
        "name": "X-VPZH-Development-Identity",
        "in": "header",
        "required": true,
        "description": "Explicit opt-in development/test phone input. This boundary is disabled in production and is not production authentication.",
        "schema": { "type": "string", "minLength": 1, "maxLength": 255 }
      },
      "ProductId": {
        "name": "productId",
        "in": "path",
        "required": true,
        "description": "Backend Product UUID.",
        "schema": { "type": "string", "format": "uuid" }
      },
      "ImageRevision": {
        "name": "imageRevision",
        "in": "path",
        "required": true,
        "description": "Opaque current Product image revision UUID.",
        "schema": { "type": "string", "format": "uuid" }
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "service", "version", "timestamp"],
        "properties": {
